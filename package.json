{
  "name": "xiaoxiaodeta",
  "version": "1.4.0",
  "description": "小小的她 · 安静、离线、可拖动的桌面陪伴伙伴，支持自定义形象导入、文字互动和本地成长玩法。",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1 --port 4173 --strictPort\" \"wait-on http://127.0.0.1:4173 && electron electron/main.cjs --dev\"",
    "build": "vite build",
    "build:desktop": "npm run build:portable",
    "build:portable": "npm run build && electron-builder --win dir && pwsh -File scripts/build-portable-launcher.ps1 -PackageDirectory artifacts/desktop-1.4.0/win-unpacked && pwsh -File scripts/package-portable.ps1 -PackageDirectory artifacts/desktop-1.4.0/win-unpacked",
    "capture:desktop": "concurrently -k --success first \"vite --host 127.0.0.1 --port 4173 --strictPort\" \"wait-on http://127.0.0.1:4173 && electron electron/main.cjs --dev --capture\"",
    "test": "node --test tests/pet-machine.test.mjs tests/progression.test.mjs tests/chat-replies.test.mjs tests/action-registry.test.mjs tests/memory-game.test.mjs tests/drag-coalescer.test.mjs tests/drag-session.test.mjs tests/rps-game.test.mjs tests/star-catch.test.mjs tests/pet-hit-area.test.cjs tests/custom-assets.test.mjs tests/custom-atlas-feedback.test.mjs",
    "test:atlas": "node scripts/test-atlas.cjs",
    "test:wardrobe": "node scripts/wardrobe-assets.mjs test",
    "assets:wardrobe": "node scripts/wardrobe-assets.mjs build",
    "build:installer": "npm run build && electron-builder --config electron-builder.nsis.yml --win nsis",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@vitejs/plugin-react": "5.0.4",
    "gsap": "^3.15.0",
    "lucide-react": "^0.544.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "38.8.6",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.xiaoxiaodeta.pet",
    "productName": "小小的她",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "artifacts/desktop-1.4.0"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "src/progression.js",
      "package.json",
      "!node_modules/lucide-react/**/*",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/vite/**/*",
      "!node_modules/@vitejs/plugin-react/**/*"
    ],
    "asarUnpack": [
      "dist/client/assets/**/*"
    ],
    "extraResources": [
      {
        "from": "public/assets/sprites/idle.png",
        "to": "assets/sprites/idle.png"
      },
      {
        "from": "public/assets/brand/mascot-icon.png",
        "to": "assets/brand/mascot-icon.png"
      },
      {
        "from": "launcher/shortcut-icon.ico",
        "to": "shortcut-icon.ico"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "launcher/shortcut-icon.ico"
    }
  }
}
